{
  "manifest_version": 3,
  "name": "Second Brain Saver",
  "version": "1.0",
  "description": "Save anything to your smart brain",
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://memora-wine.vercel.app/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}